&Silt_parameters
method=4
stick_fact=0.25
!-----------------------------------------------------------------------------
! Wave formulation for the resuspension (BFM Silt/wave.F90)
!  wave_method=1  jonswap() as originally compiled (default; nothing else needed)
!  wave_method=2  effective-fetch scheme, calibrated DWS 2015 (recommended);
!                 needs wave_fetch_file in getm_bio.inp (&getm_bfm_wave_nml),
!                 made with bin/wave_effective_fetch.py
! Parameters of method 2 (defaults shown; wave_gamma<0 selects 0.25)
!  wave_gamma=-1.0, wave_alpha_exp=0.8, wave_Tdmax_exp=18000.0,
!  wave_Tdmax_tp=18000.0, wave_Tz_min=1.0
!-----------------------------------------------------------------------------
wave_method=1
/
